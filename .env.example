# Agent ECHO env example
# Copy to `.env.local` and `backend/.env`.


# OpenAI
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-REPLACE_ME


# Anthropic
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=


# Twilio
# https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15555550123


# Hume AI
# https://beta.hume.ai/settings/keys
HUME_API_KEY=


# Google Maps
# https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# Firebase Firestore
# https://console.firebase.google.com/
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
EXPO_PUBLIC_FIREBASE_USER_ID=


# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=
FIREBASE_SERVER_KEY=


# Backend
BACKEND_PORT=4000
EXPO_PUBLIC_API_URL=http://localhost:4000


# Postgres
DATABASE_URL=


# Misc
NODE_ENV=development
LOG_LEVEL=info
